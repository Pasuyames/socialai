# ═════════════════════════════════════════════════════════════════════════════
# SocialAI — PRODUCTION Ortam Değişkenleri ŞABLONU
#
# Kurulum:
#   cp .env.production.example packages/web/.env
#   # ardından aşağıdaki değerleri gerçek prod değerleriyle doldurun.
#
# Worker bu dosyayı (packages/web/.env) OTOMATİK yükler (GCP/DB/Redis için);
# ayrıca packages/worker/.env varsa onu da yükler (Redis override'ı için yeterli).
# Next.js production'da packages/web/.env(.production) dosyalarını otomatik okur.
#
# ⚠️ Bu dosya yalnızca ŞABLONDUR — GERÇEK SIRLAR ASLA git'e commit'lenmez.
# ═════════════════════════════════════════════════════════════════════════════

# ── Çalışma Ortamı ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Veritabanı (SQLite) ─────────────────────────────────────────────────────
# Prod'da MUTLAK yol önerilir; web ve worker AYNI dosyaya erişmelidir.
DATABASE_URL=file:/var/www/socialai/packages/web/prisma/dev.db

# ── Görsel Çıktı Kökü (KRİTİK) ──────────────────────────────────────────────
# Görseller worker process'inden de üretilir; cwd farklı olduğundan sabitlenir.
# Web'in serve ettiği public/ klasörünün MUTLAK yolu olmalı.
PUBLIC_DIR=/var/www/socialai/packages/web/public

# ── Kimlik Doğrulama (NextAuth) ─────────────────────────────────────────────
AUTH_SECRET=__openssl_rand_base64_32_ile_uretin__
NEXTAUTH_URL=https://panel.ornekdomain.com
NEXT_PUBLIC_APP_URL=https://panel.ornekdomain.com
# Auth.js v5: localhost dışı host'larda (IP/domain) ŞART, yoksa UntrustedHost hatası
AUTH_TRUST_HOST=true

# ── Google Vertex AI (premium/balanced modeller) ────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Service account anahtar dosyasının VDS'deki mutlak yolu
GOOGLE_APPLICATION_CREDENTIALS=/var/www/socialai/secrets/gcp-sa.json

# ── Gemini AI Studio (görsel üretimi — Nano Banana 2) ───────────────────────
GEMINI_API_KEY=your-aistudio-api-key
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_SIZE=2K

# ── Redis (BullMQ kuyruğu) — docker-compose.yml ile ayağa kalkar ────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# ── Worker (kuyruk paralellik & rate-limit) ─────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_RATE_MAX=8
WORKER_RATE_DURATION=60000

# ── Gözlemlenebilirlik (Langfuse — token/maliyet izleme) ────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Veri Madenciliği / Görsel İlham (opsiyonel) ─────────────────────────────
# Boş bırakılırsa ilgili adımlar güvenle atlanır (ağa çıkmaz, boş bekleme yok).
FIRE_CRAWL_API_KEY=
UNSPLASH_ACCESS_KEY=
VISUAL_INSPIRATION_ENABLED=false
SCRAPE_TIMEOUT_MS=8000
# CRAWL4AI_URL=http://127.0.0.1:11235

# ── Sosyal Yayın Entegrasyonları (opsiyonel) ────────────────────────────────
X_API_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
