# SocialAI — ortam değişkenleri şablonu
# Gerçek değerleri .env dosyasına koyun (.env git'e COMMIT EDİLMEZ).

# ── Kimlik / Auth ──────────────────────────────────────────
AUTH_SECRET=                      # `openssl rand -base64 32` ile üret (PROD'da zorunlu)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Veritabanı ─────────────────────────────────────────────
DATABASE_URL=file:./dev.db

# ── Redis (BullMQ kuyruk + Bull-Board gözlemlenebilirlik) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Google Cloud / Vertex AI (Gemini + Imagen) ─────────────
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=   # service-account JSON dosya yolu

# ── AI Studio — Görsel üretim (Nano Banana 2) ──────────────
# GEMINI_API_KEY varsa görsel üretim Vertex yerine AI Studio'dan yapılır.
GEMINI_API_KEY=                   # aistudio.google.com/apikey
IMAGE_MODEL=gemini-3.1-flash-image  # Nano Banana 2
IMAGE_SIZE=2K                     # 1K | 2K | 4K

# ── Scraping / Görsel kaynakları ───────────────────────────
FIRE_CRAWL_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── Sosyal medya yayınlama (opsiyonel) ─────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
X_API_BEARER_TOKEN=

# ── Gözlemlenebilirlik (opsiyonel) ─────────────────────────
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
