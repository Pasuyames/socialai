# SocialAI — ortam değişkenleri şablonu
# Gerçek değerleri .env dosyasına koyun (.env git'e COMMIT EDİLMEZ).

# ── Kimlik / Auth ──────────────────────────────────────────
# NOT: dev sunucusu 3001'de çalışır (next dev -p 3001). Bu iki değer porta
# uymazsa login redirect'leri yanlış adrese gider.
AUTH_SECRET=                      # `openssl rand -base64 32` ile üret (PROD'da zorunlu)
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Ağ / Ters proxy ────────────────────────────────────────
# Rate limit'in istemci IP'sini X-Forwarded-For / X-Real-IP başlıklarından
# okuyup okumayacağını belirler. Bu başlıkları İSTEMCİ de uydurabilir; sadece
# önünde bu başlığı KENDİSİ ekleyen bir ters proxy (nginx/Cloudflare) varsa
# "true" yapın.
#   true|1     → XFF zincirinin SON elemanı istemci IP'si sayılır (limit IP başına)
#   boş/false  → başlığa güvenilmez, limit GLOBAL olur (tüm istemciler tek kova)
# Varsayılan güvenlidir (güvenme): proje PM2 ile proxy'siz de çalışabildiği için
# yanlışlıkla "güven" demek register limitini (5/saat) atlatılabilir yapardı.
TRUST_PROXY=

# ── Veritabanı ─────────────────────────────────────────────
DATABASE_URL=file:./dev.db

# ── Redis (BullMQ kuyruk + Bull-Board gözlemlenebilirlik) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Google Cloud / Vertex AI (Gemini + Imagen) ─────────────
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=   # service-account JSON dosya yolu

# ── AI Studio — Görsel üretim (Nano Banana 2) ──────────────
# GEMINI_API_KEY varsa görsel üretim Vertex yerine AI Studio'dan yapılır.
GEMINI_API_KEY=                   # aistudio.google.com/apikey
IMAGE_MODEL=gemini-3.1-flash-image  # Nano Banana 2
IMAGE_SIZE=2K                     # 1K | 2K | 4K

# ── Scraping / Görsel kaynakları ───────────────────────────
FIRE_CRAWL_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── Sosyal medya yayınlama (opsiyonel) ─────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
X_API_BEARER_TOKEN=

# Kimlik bilgileri eksikken SAHTE yayın yapılmasına izin verir (sadece geliştirme).
# Kapalıyken (varsayılan) yayın başarısız olur ve gönderi `approved` kalır.
# PROD'DA ASLA AÇMAYIN: açıkken gönderiler gerçekten paylaşılmadan `published`
# işaretlenir ve müşteri içeriğinin yayında olduğunu sanır.
PUBLISH_SIMULATE=

# ── Gözlemlenebilirlik (opsiyonel) ─────────────────────────
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Görsel çıktı dizini ────────────────────────────────────
# Üretilen görseller web paketinin public/ klasörüne yazılmalı. Görsel üretimi
# worker process'inden de tetiklenebildiği için (farklı cwd) bu yol MUTLAK verilir.
#
# ⚠️ PROJE TAŞINIRSA BURAYI GÜNCELLE. Yanlış/eski bir yol verilirse üretim
# "başarılı" görünür ama görseller servis EDİLMEYEN bir klasöre yazılır ve her
# görsel URL'i 404 döner. Tam olarak bu yaşandı: proje Desktop'tan Projects'e
# taşındı, bu değişken eski yolda kaldı ve taşınmadan sonraki ilk görsel
# üretimine kadar fark edilmedi. ImageGenerator artık dizin YOKSA hata fırlatır,
# ama VAR OLAN ama yanlış bir dizini tespit edemez — elle kontrol et.
#
# Örnek: PUBLIC_DIR=C:/Users/kullanici/Projects/SocialAI/packages/web/public
PUBLIC_DIR=
