{
  "name": "socialai",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm --filter '*' build",
    "generate": "pnpm --filter worker generate",

    "build:web": "NODE_OPTIONS=--max-old-space-size=4096 pnpm --filter web build",
    "prisma:push": "pnpm --filter worker exec bash -c 'set -a; . ../web/.env; set +a; prisma db push --schema=../web/prisma/schema.prisma'",
    "start:web": "pnpm --filter web start",
    "start:worker": "pnpm --filter worker start",

    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down",

    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",

    "deploy": "pnpm install --frozen-lockfile && pnpm redis:up && pnpm generate && pnpm prisma:push && pnpm build:web && pnpm pm2:start && pm2 save"
  },
  "pnpm": {
    "overrides": {
      "axios@>=1.0.0 <1.15.1": ">=1.15.1",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "undici@>=7.0.0 <8.5.0": ">=8.5.0"
    }
  }
}
