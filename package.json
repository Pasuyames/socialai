{
  "name": "socialai",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm --filter '*' build",
    "generate": "pnpm --filter worker generate",

    "build:web": "NODE_OPTIONS=--max-old-space-size=4096 pnpm --filter web build",
    "prisma:push": "pnpm --filter worker exec bash -c 'set -a; . ../web/.env; set +a; prisma db push --schema=../web/prisma/schema.prisma'",
    "start:web": "pnpm --filter web start",
    "start:worker": "pnpm --filter worker start",

    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down",

    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",

    "deploy": "pnpm install --frozen-lockfile && pnpm redis:up && pnpm generate && pnpm prisma:push && pnpm build:web && pnpm pm2:start && pm2 save"
  },
  "pnpm": {
    "overrides": {
      "axios@>=1.0.0 <1.15.1": ">=1.15.1",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "undici@>=7.0.0 <8.9.0": ">=8.9.0",
      "protobufjs@>=7.0.0 <7.6.5": ">=7.6.5",
      "@protobufjs/utf8@<1.1.1": ">=1.1.1",
      "nanoid@>=3.0.0 <3.3.18": ">=3.3.18",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "postcss@>=8.0.0 <8.5.23": ">=8.5.23",
      "browserslist@<4.28.7": ">=4.28.7",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
      "qs@>=2.2.5 <6.16.0": ">=6.16.0",
      "uuid@>=11.0.0 <11.1.1": ">=11.1.1",
      "dompurify@<3.4.13": ">=3.4.13",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": ">=2.11.0",
      "hono@<4.13.5": ">=4.13.5",
      "@hono/node-server@<2.0.10": ">=2.0.10",
      "postcss-selector-parser@>=6.1.0 <6.1.3": ">=6.1.3",
      "@babel/core@<7.29.6": ">=7.29.6"
    }
  }
}
